# Dependencias (se reinstalan con npm install)
node_modules/

# Renders y vídeos pesados (GitHub bloquea archivos > 100 MB)
*.mp4
*.mov
*.mkv
out/
episodes/*/out/
ref/

# Cachés y archivos temporales
.remotion/
.DS_Store
Thumbs.db
*.log
.env
# Perfil de Chrome y fotogramas sueltos del render (se regeneran solos; eran ~280 MB en git)
**/.chrome-render-profile/
**/render-frames*/
# Caché de tomas de ElevenLabs (audio en base64, se regenera)
tmp/
